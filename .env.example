# Base de données
DB_URL=postgresql+asyncpg://user:password@localhost:5432/oubliepas
DB_URL_TEST=postgresql+asyncpg://user:password@localhost:5432/oubliepas_test

# JWT
JWT_SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@oubliepas.com
RESEND_FROM_NAME=OubliePas
RESEND_FROM_EMAIL_SUPPORT=support@oubliepas.com

# Cloudflare R2
API_S3=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JETON_VALUE=
FOLDER_NAME=avatars
S3_BUCKET_NAME=oubliepas
AVATAR_URL_EXPIRE_SECONDS=86400

# Frontend
FRONTEND_URL=http://localhost:5173

# Rate limiting
# Vide en local (compteurs en memoire). Sur Railway : reference le service Redis
# via ${{Redis.REDIS_URL}} pour que les compteurs survivent aux redeploiements
# et soient partages entre replicas.
REDIS_URL=

# Nombre de proxys de confiance devant l'app, pour lire X-Forwarded-For.
# 0 en local (pas de proxy). Sur Railway : 1 (l'edge Envoy).
# A verifier avec GET /debug/client-ip avant de figer la valeur.
TRUSTED_PROXY_COUNT=0

# Divers
DEBUG=false
SQL_ECHO=false
CORS_ORIGINS=http://localhost:5173
