# Copier vers .env et remplir. Aucune valeur reelle ici.

# --- Obligatoires : l'application refuse de demarrer sans elles ---
JWT_SECRET_KEY=
RESEND_API_KEY=
# DB_URL est accepte comme alias et l'emporte s'il est defini.
DATABASE_URL=postgresql://user:password@localhost:5432/oubliepas
DB_URL_TEST=postgresql+asyncpg://user:password@localhost:5432/oubliepas_test

# --- Reseau et proxy ---
# Nombre de proxys de confiance places devant l'application. A 0, la cle de
# limitation de debit est l'adresse du pair TCP, c'est-a-dire le proxy lui-meme :
# tous les visiteurs partagent alors un seul seau et /auth/login tombe a
# 10 tentatives par minute pour l'ensemble du trafic. Railway place exactement
# un proxy, d'ou la valeur 1. Ne pas monter au-dela du nombre reel de sauts :
# chaque saut de trop rend un cran de X-Forwarded-For falsifiable par le client.
TRUSTED_PROXY_COUNT=1

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=

# --- Limitation de debit ---
# Sans Redis, les compteurs vivent dans la memoire du processus : ils repartent
# de zero a chaque redeploiement et a chaque redemarrage, et chaque replique
# tient les siens, ce qui multiplie la limite reelle par le nombre d'instances.
# Renseigner cette variable suffit, le repli memoire reste actif si Redis tombe.
REDIS_URL=

# --- Jetons ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cookie de rafraichissement ---
# SameSite=none exige Secure=true, et l'application refuse de demarrer autrement.
# Si le front est servi depuis un autre site que l'API, lax fait abandonner le
# cookie par le navigateur, sans message.
REFRESH_COOKIE_NAME=oubliepas_refresh
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Courriel ---
RESEND_FROM_EMAIL=hello@oubliepas.com
RESEND_FROM_NAME=OubliePas
RESEND_FROM_EMAIL_SUPPORT=support@oubliepas.com
RESEND_FROM_EMAIL_REMINDER=reminder@oubliepas.com
# Destinataire de l'alerte de quota d'envoi, une fois par passage du cron quand
# la journee depasse le seuil. Vide, l'alerte est simplement desactivee.
OPERATOR_EMAIL=

# --- Stockage objet (avatars) ---
API_S3=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=oubliepas
FOLDER_NAME=avatars
AVATAR_URL_EXPIRE_SECONDS=86400

# --- Developpement ---
DEBUG=false
SQL_ECHO=false
